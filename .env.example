# Supabase (Settings > API). Solo la anon key: NUNCA pongas la service_role aquí.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Dominio base para los subdominios de cada restaurante (sin https://).
# Si lo dejas vacío, el menú público se sirve en /m/<slug> (útil en desarrollo y en previews de Vercel).
VITE_BASE_DOMAIN=

# Código de país que se antepone a números de WhatsApp de hasta 9 dígitos (Perú = 51)
VITE_DEFAULT_COUNTRY_CODE=51
